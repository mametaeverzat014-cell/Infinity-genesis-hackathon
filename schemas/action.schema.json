{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/action.schema.json",
  "title": "Agent action",
  "description": "Anything else is answered with a bounded error and still uses one step.",
  "oneOf": [
    {"type": "object", "required": ["action", "table"],
     "properties": {"action": {"const": "list_records"}, "table": {"enum": ["ledger", "invoices", "payments", "fx"]},
                    "cursor": {"type": ["string", "null"]}, "limit": {"type": "integer", "minimum": 1,
                    "description": "values above 50 are clipped to 50"}}},
    {"type": "object", "required": ["action", "table", "id"],
     "properties": {"action": {"const": "get_record"}, "table": {"enum": ["ledger", "invoices", "payments", "fx"]},
                    "id": {"type": "string", "maxLength": 64}}},
    {"type": "object", "required": ["action", "doc_id"],
     "properties": {"action": {"const": "get_document"}, "doc_id": {"type": "string", "maxLength": 64}}},
    {"type": "object", "required": ["action", "expression"],
     "properties": {"action": {"const": "calculator"}, "expression": {"type": "string", "maxLength": 300}}},
    {"type": "object", "required": ["action", "findings"], "additionalProperties": false,
     "properties": {"action": {"const": "submit"},
                    "findings": {"description": "findings.json object, or the findings list together with episode_id"},
                    "episode_id": {"type": "string"}}}
  ]
}
