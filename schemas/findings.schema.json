{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/findings.schema.json",
  "title": "findings.json (submit payload)",
  "description": "Validated by auditgym.matcher.normalize_submission. Any violation ends the episode with reward -1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "findings"],
  "properties": {
    "episode_id": {"type": "string", "description": "must equal manifest.episode_id"},
    "findings": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids"],
        "properties": {
          "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_conversion", "period_cutoff"],
                   "description": "case-insensitive"},
          "affected_ids": {"type": "array", "minItems": 1, "maxItems": 10,
                           "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "claimed_amount_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
          "currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
          "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "explanation": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
