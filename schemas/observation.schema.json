{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/observation.schema.json",
  "title": "Observation",
  "oneOf": [
    {"type": "object", "title": "reset",
     "required": ["kind", "task", "episode_id", "manifest", "policy", "tools", "submission_format", "steps_remaining"],
     "properties": {"kind": {"const": "reset"}, "steps_remaining": {"type": "integer"}}},
    {"type": "object", "title": "step / terminal", "additionalProperties": false,
     "required": ["kind", "step", "action", "result", "error", "steps_remaining"],
     "properties": {
       "kind": {"enum": ["step", "terminal"]},
       "step": {"type": "integer"},
       "action": {"type": ["string", "null"]},
       "result": {"description": "requested rows / record / document / value; terminal: {status, reason?}"},
       "error": {"type": ["object", "null"], "properties": {"code": {"type": "string"},
                 "message": {"type": "string", "maxLength": 200}}},
       "steps_remaining": {"type": "integer", "minimum": 0}
     }}
  ]
}
