{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/truth.schema.json",
  "title": "truth.json (grader only)",
  "type": "object",
  "required": ["schema_version", "episode_id", "base_currency", "clean", "issues"],
  "properties": {
    "issues": {"type": "array", "maxItems": 12, "items": {
      "type": "object",
      "required": ["issue_id", "type", "variant", "scenario", "affected_ids", "expected_amount_minor", "currency",
                   "evidence_sets"],
      "properties": {
        "issue_id": {"type": "string"},
        "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_conversion", "period_cutoff"]},
        "variant": {"type": "string"},
        "scenario": {"type": ["string", "null"]},
        "affected_ids": {"type": "array", "items": {"type": "string"}, "description": "canonical set"},
        "expected_amount_minor": {"type": "integer", "minimum": 1},
        "currency": {"type": "string"},
        "evidence_sets": {"type": "array", "minItems": 1,
                          "items": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
                          "description": "a finding needs ALL ids of at least ONE set"}
      }}}
  }
}
